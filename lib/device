# Device maintenance over the J-Link USB serial shell. The `vg` verbs are
# the same on all three firmware images, so info/clear/confirm/wipe work
# against whichever is flashed (USB access is the possession proof). Also
# hosts the link-security loopback self-tests and the provisioning flows.
#
# Usage: lib/device info|clear|confirm|wipe|self-test|noise-ca-gen|noise-ca-root|noise-ca-sign [--port ...]
set -euo pipefail
cd "$(dirname "$0")/.."

dotnet run --project tools/Provision -- "$@"
