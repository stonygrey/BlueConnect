#!/bin/bash
# Copyright © 2026 Stony Grey LLC.
# SPDX-License-Identifier: MIT
# Builds (incrementally) and flashes the firmware to the attached board
# over its onboard J-Link, then resets the board.
#
# Usage: lib/flash-firmware [--pristine]
#
# Environment overrides: NCS_VERSION, BOARD, NCS_ROOT (see lib/build-firmware);
# SNR to select a specific J-Link by serial number when more than one is
# attached.
#
# Prerequisites: SEGGER J-Link tools installed; kit connected via the
# onboard J-Link USB and powered on. From WSL the probe must first be
# attached with usbipd (see documents/build-deploy.md).
set -euo pipefail
cd "$(dirname "$0")/.."

"$(dirname "$0")/build-firmware" "$@"

export PATH="$HOME/bin:$PATH"

NCS_VERSION="${NCS_VERSION:-v3.4.0}"

if [[ -z "${NCS_ROOT:-}" ]]; then
  for candidate in /opt/nordic/ncs "$HOME/ncs"; do
    if [[ -d "$candidate/$NCS_VERSION" ]]; then
      NCS_ROOT="$candidate"
      break
    fi
  done
  NCS_ROOT="${NCS_ROOT:-/opt/nordic/ncs}"
fi

BUILD_DIR="$(pwd)/firmware/noise/build"
WORKSPACE="$NCS_ROOT/$NCS_VERSION"

SNR_ARG=""
if [[ -n "${SNR:-}" ]]; then
  SNR_ARG="--snr $SNR"
fi

nrfutil sdk-manager toolchain launch --ncs-version "$NCS_VERSION" -- bash -c \
  "cd '$WORKSPACE' && west flash -d '$BUILD_DIR' $SNR_ARG"

echo "flashed + reset"
