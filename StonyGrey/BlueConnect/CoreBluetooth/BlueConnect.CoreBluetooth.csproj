<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-macos joins this list when the bct CLI arrives -->
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <RootNamespace>StonyGrey.BlueConnect.CoreBluetooth</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\BlueConnect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="StonyGrey.Logging" />
  </ItemGroup>

</Project>
