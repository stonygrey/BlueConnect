<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StonyGrey.Edhoc</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- BouncyCastle for P-256 point arithmetic and AES-CCM, neither of which
         the BCL exposes portably (ECDiffieHellman/AesCcm are platform-backed
         on MAUI targets). Pure managed, so it runs everywhere. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <!-- CBOR is not in the shared framework. Canonical writers give the
         RFC 8949 deterministic encoding EDHOC requires (RFC 9528 §3.1). -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Edhoc.Tests" />
  </ItemGroup>

</Project>
