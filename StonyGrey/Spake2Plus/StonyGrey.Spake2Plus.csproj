<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StonyGrey.Spake2Plus</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- BouncyCastle for P-256 point arithmetic (x·G + w0·M etc.), which the
         BCL's ECDiffieHellman does not expose. Pure managed, so it runs on
         every MAUI target. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spake2Plus.Tests" />
  </ItemGroup>

</Project>
