<resources>
    <!-- The window while the process starts: the system splash (API 31 and
         later, which minSdk 34 guarantees) draws the launcher artwork on
         Zaffre blue, and launch_background keeps that look until Flutter
         draws its first frame. The parent is the dark variant because this
         file is the values-night resource. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <!-- The window behind the Flutter UI once it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
