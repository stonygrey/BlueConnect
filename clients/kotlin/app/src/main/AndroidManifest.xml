<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE central role on Android 12 and later. Scanning is not used to derive location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".ZaffreApplication"
        android:allowBackup="false"
        android:label="Zaffre Kotlin"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Zaffre">
        <!-- Google's code scanner module, downloaded by Play services with the app. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Zaffre">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
