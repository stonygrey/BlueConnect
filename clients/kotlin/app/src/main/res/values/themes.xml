<!--
  The activity theme. DeviceDefault follows the system's light or dark
  setting, and the Compose content picks its colour scheme the same way in
  MainActivity; NoActionBar because the Compose Scaffold draws its own bar.
  The splash attributes draw the launcher artwork on Zaffre blue while the
  process starts. They must be on the activity's theme, not only the
  application's, because the system splash reads the launched activity's
  theme. minSdk 34 is past API 31, where these attributes appeared, so no
  qualified resource folder is needed.
-->
<resources>
    <style name="Theme.Zaffre" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
