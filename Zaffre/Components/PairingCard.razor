@typeparam TViewModel where TViewModel : PrivilegedCommandsViewModel
@using Zaffre.Services.Abstractions
@inherits ReactiveComponentBase<TViewModel>

@* One tier's Noise pairing as a collapsible panel: the title carries the
   current state (amber when this side believes it is paired but the device
   advertises nothing pinned); the body offers the two ways to enable the
   tier — Pair (ceremony) or Provision (QR payload) — or Unpair. *@

<MudExpansionPanel Disabled="@WrongScheme">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(ViewModel!.IsPaired ? Icons.Material.Filled.Phonelink : Icons.Material.Filled.PhonelinkOff)"
                     Color="@(ViewModel!.IsPaired ? (ViewModel!.DeviceSecured ? Color.Success : Color.Warning) : Color.Default)"
                     Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">
                @ViewModel!.RoleTitle: @StateLabel
            </MudText>
        </MudStack>
    </TitleContent>
    <ChildContent>
        @if (ViewModel!.IsPaired)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" Class="vg-method-btn"
                           StartIcon="@Icons.Material.Filled.LinkOff"
                           Disabled="@(!ViewModel!.CanRun || WrongScheme)" OnClick="@(() => ClickOnce(Unpair))">
                    Unpair
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@ViewModel!.PairingStatus</MudText>
            </MudStack>
        }
        else
        {
            @* The two ways in, kept well apart. Manual payload entry is
               hidden — the QR scan is the path (the paste plumbing survives
               in the view model). *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium" Class="vg-method-btn"
                           StartIcon="@Icons.Material.Filled.Link"
                           Disabled="@(!ViewModel!.CanRun || WrongScheme)" OnClick="@(() => ClickOnce(Pair))">
                    Pair
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Confirm with @ViewModel!.ConfirmButton
                </MudText>
            </MudStack>
            <MudDivider Class="my-2" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                @if (ViewModel!.CanScan)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" Class="vg-method-btn"
                               StartIcon="@Icons.Material.Filled.QrCodeScanner"
                               Disabled="@(!ViewModel!.CanRun || WrongScheme)" OnClick="@(() => ClickOnce(ScanProvisioned))">
                        Provision
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Scan QR
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Provisioning needs the camera. Scan the QR on a phone.
                    </MudText>
                }
            </MudStack>
        }
        <MudText Typo="Typo.caption" Class="mt-1 mud-text-secondary" Style="min-height: 1.2em;">@ViewModel!.PairResult</MudText>
    </ChildContent>
</MudExpansionPanel>

@code {
    // The ceremony is meaningless against a PAKE or EDHOC device; the
    // page's alert explains where to go instead. Unknown stays enabled (no
    // packet yet).
    private bool WrongScheme => ViewModel!.DeviceScheme
        is AuthenticationScheme.Pake or AuthenticationScheme.Edhoc;

    private string StateLabel => !ViewModel!.IsPaired ? "Unsecured" : ViewModel!.CredentialOrigin switch
    {
        CredentialOrigin.Provisioned => "Provisioned",
        CredentialOrigin.Enrolled => "Enrolled",
        _ => "Paired",
    };

    // One named handler per button: ClickOnce keys its single-flight guard on
    // the handler method, so each button is guarded independently.
    private Task Pair() => ViewModel!.PairCommand.Execute().ToTask();

    private Task Unpair() => ViewModel!.UnpairCommand.Execute().ToTask();

    private Task ScanProvisioned() => ViewModel!.ScanProvisionedCommand.Execute().ToTask();

    private Task SaveProvisioned() => ViewModel!.SaveProvisionedCommand.Execute().ToTask();
}
