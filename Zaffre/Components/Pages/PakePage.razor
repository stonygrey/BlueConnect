@page "/pake"
@using Zaffre.Services.Abstractions
@inherits ReactiveComponentBase<LowPrivilegeCommandsViewModel>
@inject NavigationManager Navigation

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/"))" />
        <MudText Typo="Typo.h5">@ViewModel!.DeviceName</MudText>
        <AuthenticationSchemeChip Scheme="@ViewModel!.DeviceScheme" />
    </MudStack>

    <TestNav />

    <SchemeIntro Lead="SPAKE2+ link security; the setup code is the credential."
                 ProvisionText="Scan the setup-code QR created over USB"
                 Command="lib/device pake-provision"
                 Note="There is no pairing ceremony." />

    @if (WrongScheme)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            The selected device advertises @(ViewModel!.DeviceScheme == AuthenticationScheme.Edhoc ? "EDHOC" : "Noise") link security. Use its own tab instead.
        </MudAlert>
    }

    <MudExpansionPanels MultiExpansion="true">
        <PakeCredentialCard Role="PairingRole.High" Disabled="@WrongScheme" />
        <PakeCredentialCard Role="PairingRole.Low" Disabled="@WrongScheme" />
    </MudExpansionPanels>
</MudStack>

@code {
    // The setup-code cards are inert against a Noise or EDHOC device; the
    // alert above explains where to go instead. Unknown stays enabled (no
    // packet yet).
    private bool WrongScheme => ViewModel!.DeviceScheme
        is AuthenticationScheme.Noise or AuthenticationScheme.Edhoc;
}
