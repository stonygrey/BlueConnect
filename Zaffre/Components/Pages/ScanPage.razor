@page "/"
@inherits ReactiveComponentBase<ScanViewModel>
@inject NavigationManager Navigation

<MudStack Spacing="4">
    <MudText Typo="Typo.h5">Select a device</MudText>

    @if (ViewModel!.Devices.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="mt-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2">Scanning for Verdigris devices&hellip;</MudText>
        </MudStack>
    }
    else
    {
        @foreach (var device in ViewModel!.Devices)
        {
            <MudPaper Elevation="1" Class="pa-3 cursor-pointer" @onclick="() => Select(device)">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1">@device.LocalName</MudText>
                        <MudText Typo="Typo.caption">@device.Id</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @* Every row shows its security state; what the padlock
                           means depends on the advertised scheme — Noise: a
                           client key is pinned; PAKE: a setup code's verifier
                           is provisioned (any code holder is accepted);
                           EDHOC: an initiator credential is pinned. *@
                        @if (device.IsSecured)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Success"
                                     title="@(device.AuthenticationScheme switch
                                         {
                                             AuthenticationScheme.Pake => "Setup code provisioned. Sessions require the code",
                                             AuthenticationScheme.Edhoc => "Credential provisioned. Sessions require the paired credential",
                                             _ => "Paired. Only the pinned client is accepted",
                                         })" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Default"
                                     title="@(device.AuthenticationScheme switch
                                         {
                                             AuthenticationScheme.Pake => "No setup code provisioned. Provision over USB",
                                             AuthenticationScheme.Edhoc => "No credential provisioned. Provision over USB",
                                             _ => "Not paired. Any client can open an encrypted session",
                                         })" />
                        }
                        <AuthenticationSchemeChip Scheme="@device.AuthenticationScheme" />
                        @if (!device.IsConnectable)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">not connectable</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@($"{device.Rssi.ValueDbm} dBm")</MudChip>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

<MudText Typo="Typo.caption"
         Style="position: fixed; left: 12px; bottom: calc(6px + env(safe-area-inset-bottom)); color: #9e9e9e; font-size: 0.7rem; pointer-events: none;">
    @($"v{AppInfo.Current.VersionString}")
</MudText>

@code {
    private void Select(IAdvertisement device)
    {
        ViewModel!.Select(device);

        // Land where the device's transport says the user will act first:
        // its security tab. Unknown (no status byte seen yet) keeps the
        // historical default.
        Navigation.NavigateTo(device.AuthenticationScheme switch
        {
            AuthenticationScheme.Pake => "/pake",
            AuthenticationScheme.Edhoc => "/edhoc",
            AuthenticationScheme.Noise => "/noise",
            _ => "/test",
        });
    }
}
