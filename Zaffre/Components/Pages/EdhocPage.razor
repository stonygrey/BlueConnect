@page "/edhoc"
@using Zaffre.Services.Abstractions
@inherits ReactiveComponentBase<LowPrivilegeCommandsViewModel>
@inject NavigationManager Navigation

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/"))" />
        <MudText Typo="Typo.h5">@ViewModel!.DeviceName</MudText>
        <AuthenticationSchemeChip Scheme="@ViewModel!.DeviceScheme" />
    </MudStack>

    <TestNav />

    <SchemeIntro Lead="EDHOC link security (RFC 9528); each tier is enabled independently."
                 PairText="Keys are generated on both ends, confirmed with the board's button."
                 ProvisionText="Scan the QR created over USB"
                 Command="lib/device edhoc-provision"
                 Note="A provisioned tier cannot be re-paired." />

    @if (WrongScheme)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            The selected device advertises @(ViewModel!.DeviceScheme == AuthenticationScheme.Pake ? "PAKE" : "Noise") link security. Use its own tab instead.
        </MudAlert>
    }

    <MudExpansionPanels MultiExpansion="true">
        <EdhocCredentialCard Role="PairingRole.High" Disabled="@WrongScheme" />
        <EdhocCredentialCard Role="PairingRole.Low" Disabled="@WrongScheme" />
    </MudExpansionPanels>
</MudStack>

@code {
    // The credential cards are inert against a Noise or PAKE device; the
    // alert above explains where to go instead. Unknown stays enabled (no
    // packet yet).
    private bool WrongScheme => ViewModel!.DeviceScheme
        is AuthenticationScheme.Noise or AuthenticationScheme.Pake;
}
