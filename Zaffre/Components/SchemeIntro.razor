@* The trust page's intro: a one-line scheme headline, then a legend with
   one row per way in, each led by the same icon its button carries in the
   panels below. *@

<MudStack Spacing="1">
    @if (Lead is not null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Lead</MudText>
    }
    @if (PairText is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Class="mud-text-secondary" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary"><b>Pair</b>: @PairText</MudText>
        </MudStack>
    }
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Small" Class="mud-text-secondary" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            <b>Provision</b>: @ProvisionText@if (Command is not null)
            {
                <text> (</text><code>@Command</code><text>)</text>
            }.
            @Note
        </MudText>
    </MudStack>
</MudStack>

@code {
    /// <summary>The scheme headline ("Noise XX link security.").</summary>
    [Parameter] public string? Lead { get; set; }

    /// <summary>Omit on schemes with no ceremony (PAKE).</summary>
    [Parameter] public string? PairText { get; set; }

    [Parameter] public string ProvisionText { get; set; } = string.Empty;

    /// <summary>The lib/device command that mints the QR.</summary>
    [Parameter] public string? Command { get; set; }

    /// <summary>Trailing note ("A provisioned tier cannot be re-paired.").</summary>
    [Parameter] public string? Note { get; set; }
}
