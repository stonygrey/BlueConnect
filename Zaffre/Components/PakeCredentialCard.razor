@using Zaffre.Services.Abstractions
@inherits ReactiveComponentBase<PakeCredentialsViewModel>

@* One tier's PAKE setup code as a collapsible panel: the title carries the
   current state. Provisioning is the only way in — PAKE has no ceremony. *@

<MudExpansionPanel Disabled="@Disabled">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(HasCode ? Icons.Material.Filled.Phonelink : Icons.Material.Filled.PhonelinkOff)"
                     Color="@(HasCode ? Color.Success : Color.Default)" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">
                @(Role == PairingRole.High ? "High privilege" : "Low privilege"): @(HasCode ? "Provisioned" : "Unsecured")
            </MudText>
        </MudStack>
    </TitleContent>
    <ChildContent>
        @if (HasCode)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" Class="vg-method-btn"
                           StartIcon="@Icons.Material.Filled.LinkOff"
                           Disabled="@(ViewModel!.IsBusy || Disabled)" OnClick="@(() => ClickOnce(Clear))">
                    Unpair
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@ViewModel!.StatusFor(Role)</MudText>
            </MudStack>
        }
        else
        {
            @* Manual code entry is hidden with the other payload inputs —
               the QR scan is the path (the typing plumbing survives in the
               view model). *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                @if (ViewModel!.CanScan)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" Class="vg-method-btn"
                               StartIcon="@Icons.Material.Filled.QrCodeScanner"
                               Disabled="@(ViewModel!.IsBusy || Disabled)" OnClick="@(() => ClickOnce(Scan))">
                        Provision
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Scan QR
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Provisioning needs the camera. Scan the QR on a phone.
                    </MudText>
                }
            </MudStack>
        }
    </ChildContent>
</MudExpansionPanel>

@code {
    [Parameter] public PairingRole Role { get; set; }

    /// <summary>Set when the selected device does not speak PAKE.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasCode => ViewModel!.State.For(Role).HasCode;

    private string Input
    {
        get => Role == PairingRole.High ? ViewModel!.HighInput : ViewModel!.LowInput;
        set
        {
            if (Role == PairingRole.High)
            {
                ViewModel!.HighInput = value;
            }
            else
            {
                ViewModel!.LowInput = value;
            }
        }
    }

    // One named handler per button: ClickOnce keys its single-flight guard on
    // the handler method, so each button is guarded independently.
    private Task Scan() => ViewModel!.Scan(Role);

    private Task Save() => ViewModel!.SaveManual(Role);

    private Task Clear() => ViewModel!.Clear(Role);
}
