@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<ToastBridge />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@ZaffreIcon" Class="mr-2" />
        <MudText Typo="Typo.h6">Zaffre</MudText>
    </MudAppBar>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

