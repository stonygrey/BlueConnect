@using Zaffre.Services.Abstractions
@inherits ReactiveComponentBase<EdhocCredentialsViewModel>

@* One tier's EDHOC credential as a collapsible panel: the title carries the
   current state; the body offers the two ways to enable the tier — Pair
   (ceremony) or Provision (QR payload) — or the stored credential's Clear. *@

<MudExpansionPanel Disabled="@Disabled">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(HasCredential ? Icons.Material.Filled.Phonelink : Icons.Material.Filled.PhonelinkOff)"
                     Color="@(HasCredential ? Color.Success : Color.Default)" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">
                @(Role == PairingRole.High ? "High privilege" : "Low privilege"): @StateLabel
            </MudText>
        </MudStack>
    </TitleContent>
    <ChildContent>
        @if (HasCredential)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" Class="vg-method-btn"
                           StartIcon="@Icons.Material.Filled.LinkOff"
                           Disabled="@(ViewModel!.IsBusy || Disabled)" OnClick="@(() => ClickOnce(Clear))">
                    Unpair
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@ViewModel!.StatusFor(Role)</MudText>
            </MudStack>
        }
        else
        {
            @* The two ways in, kept well apart. Manual payload entry is
               hidden — nobody types an EDHOC key; the QR scan is the path
               (the paste plumbing survives in the view model). *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium" Class="vg-method-btn"
                           StartIcon="@Icons.Material.Filled.Link"
                           Disabled="@(ViewModel!.IsBusy || Disabled)" OnClick="@(() => ClickOnce(Pair))">
                    Pair
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Confirm with @(Role == PairingRole.High ? "Button 3" : "Button 2")
                </MudText>
            </MudStack>
            <MudDivider Class="my-2" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                @if (ViewModel!.CanScan)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" Class="vg-method-btn"
                               StartIcon="@Icons.Material.Filled.QrCodeScanner"
                               Disabled="@(ViewModel!.IsBusy || Disabled)" OnClick="@(() => ClickOnce(Scan))">
                        Provision
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Scan QR
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Provisioning needs the camera. Scan the QR on a phone.
                    </MudText>
                }
            </MudStack>
        }
    </ChildContent>
</MudExpansionPanel>

@code {
    [Parameter] public PairingRole Role { get; set; }

    /// <summary>Set when the selected device does not speak EDHOC.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool HasCredential => ViewModel!.State.For(Role).HasCredential;

    private string StateLabel => !HasCredential ? "Unsecured" : ViewModel!.State.For(Role).Origin switch
    {
        CredentialOrigin.Provisioned => "Provisioned",
        CredentialOrigin.Enrolled => "Enrolled",
        _ => "Paired",
    };

    private string Input
    {
        get => Role == PairingRole.High ? ViewModel!.HighInput : ViewModel!.LowInput;
        set
        {
            if (Role == PairingRole.High)
            {
                ViewModel!.HighInput = value;
            }
            else
            {
                ViewModel!.LowInput = value;
            }
        }
    }

    // One named handler per button: ClickOnce keys its single-flight guard on
    // the handler method, so each button is guarded independently.
    private Task Pair() => ViewModel!.Pair(Role);

    private Task Scan() => ViewModel!.Scan(Role);

    private Task Save() => ViewModel!.SaveManual(Role);

    private Task Clear() => ViewModel!.Clear(Role);
}
