# Forked from NCS peripheral_uart; adds CONFIG_VERDIGRIS (EDHOC app).
#

source "Kconfig.zephyr"

menu "Verdigris firmware"

config BT_NUS
	default y if !VERDIGRIS

config VERDIGRIS
	bool "Verdigris binary command/response protocol over NUS"
	default y
	select NANOPB
	help
	  When enabled, bytes received on the NUS RX characteristic are parsed
	  as length-prefixed protobuf Requests and answered with Responses on
	  the TX characteristic. When disabled, the firmware behaves exactly
	  like the stock peripheral_uart sample (BLE<->UART bridge).

config BT_NUS_THREAD_STACK_SIZE
	int "Thread stack size"
	default 1024
	help
	  Stack size used in each of the two threads

config BT_NUS_UART_BUFFER_SIZE
	int "UART payload buffer element size"
	default 40
	help
	  Size of the payload buffer in each RX and TX FIFO element

config BT_NUS_SECURITY_ENABLED
	bool "Security"
	default n if VERDIGRIS
	default y
	select BT_SMP
	help
	  Enable Bluetooth LE security (SMP) for the UART service. Off
	  under Verdigris: link security is EDHOC on the Verdigris
	  characteristics, which do not require ATT encryption. Leaving
	  the leftover NUS pairing UI enabled stole the same DK buttons
	  and could occupy the single BLE bond slot.

config BT_NUS_UART_RX_WAIT_TIME
	int "Timeout for UART RX complete event"
	default 50000
	help
	  Wait for RX complete event time in microseconds

config SETTINGS
	default y

config ZMS
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

endmenu
