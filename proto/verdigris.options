# nanopb bounds: every variable-size field is capped so the firmware decodes
# into static buffers with no heap. Keep in sync with VerdigrisPeripheral.MaxFrame.
verdigris.EchoRequest.payload  max_size:2048
verdigris.EchoResponse.payload max_size:2048
verdigris.Response.detail      max_size:64
verdigris.NameResponse.name    max_size:20
verdigris.EnrollRequest.client_public_key max_size:32
